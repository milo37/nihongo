\set ON_ERROR_STOP on

-- This file is never run by docker-entrypoint-initdb.d because `.psql` is not
-- an init suffix. The README runbook invokes it once per database after migrate
-- and seed, using the migration wrapper over the same host path as the API, so
-- the recorded server address and port match what the API runtime check sees.
BEGIN;
SET LOCAL search_path = public, pg_catalog;
INSERT INTO "DatabaseCapability" (
  "id", "databaseName", "serverAddress", "serverPort", "environment"
) VALUES (
  1, current_database(), inet_server_addr(), inet_server_port(),
  :'environment'::"AdminAuditEnvironment"
);
COMMIT;
