    {
      "clientItemId": "n5-b2-vocabulary-09",
      "content": {
        "level": "N5",
        "subject": "VOCABULARY",
        "questionType": "ORTHOGRAPHY",
        "difficulty": "NORMAL",
        "questionText": "日よう日に「ともだち」と あそびます。「ともだち」を かんじで かくと どれですか。",
        "passage": null,
        "explanationKo": "핵심: ともだち(친구) = 友だち\n친구 「ともだち」는 「友だち」로 씁니다. 反·有·支는 모양이 비슷하지만 「とも」로 읽지 않습니다.",
        "explanationJa": null,
