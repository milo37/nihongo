    {
      "clientItemId": "n5-b2-vocabulary-04",
      "content": {
        "level": "N5",
        "subject": "VOCABULARY",
        "questionType": "KANJI_READING",
        "difficulty": "NORMAL",
        "questionText": "「休み」の 日に えいがを 見ます。この 文の「休み」の よみかたは どれですか。",
        "passage": null,
        "explanationKo": "핵심: 休み = やすみ(쉬는 날)\n「休み」는 쉬는 날·휴일이라는 뜻으로 「やすみ」로 읽습니다. 나머지는 탁음·모음을 바꾼 잘못된 읽기입니다.",
        "explanationJa": null,
        "tagNames": ["vocab.basic-noun"],
        "options": [
          {
            "clientOptionKey": "option-1",
            "text": "よすみ"
          },
          {
            "clientOptionKey": "option-2",
            "text": "やずみ"
