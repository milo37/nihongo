    },
    {
      "clientItemId": "n5-b2-vocabulary-05",
      "content": {
        "level": "N5",
        "subject": "VOCABULARY",
        "questionType": "KANJI_READING",
        "difficulty": "NORMAL",
        "questionText": "えきの「北」がわに ぎんこうが あります。この 文の「北」の よみかたは どれですか。",
        "passage": null,
        "explanationKo": "핵심: 北 = きた(북쪽). 동서남북은 ひがし·にし·みなみ·きた\n「北」는 북쪽으로 「きた」로 읽습니다. みなみ는 南(남), ひがし는 東(동), にし는 西(서)입니다.",
        "explanationJa": null,
        "tagNames": ["vocab.basic-noun"],
        "options": [
          {
            "clientOptionKey": "option-1",
            "text": "きた"
          },
