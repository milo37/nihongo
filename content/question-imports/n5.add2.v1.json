    {
      "clientItemId": "n5-a3-vocabulary-17",
      "content": {
        "level": "N5",
        "subject": "VOCABULARY",
        "questionType": "WORD_USAGE",
        "difficulty": "NORMAL",
        "questionText": "「あびる」の つかいかたが いちばん よい 文は どれですか。",
        "passage": null,
        "explanationKo": "핵심: あびる = (샤워·물을) 뒤집어쓰다\n「シャワーを あびる」가 맞는 쓰임입니다. 물을 마시는 것은 のむ, 책은 よむ, 코트는 きる를 씁니다.",
        "explanationJa": null,
        "tagNames": ["vocab.verb"],
        "options": [
          {
            "clientOptionKey": "option-1",
            "text": "のどが かわいたので、みずを あびました。"
          },
          {
            "clientOptionKey": "option-2",
            "text": "へやで ほんを あびて います。"
          },
          {
            "clientOptionKey": "option-3",
            "text": "さむいので、コートを あびて 出かけます。"
          },
          {
            "clientOptionKey": "option-4",
            "text": "あさ シャワーを あびてから がっこうへ いきます。"
          }
        ],
        "correctOptionKey": "option-4"
      }
    },
    {
      "clientItemId": "n5-a3-vocabulary-18",
      "content": {
        "level": "N5",
        "subject": "VOCABULARY",
        "questionType": "WORD_USAGE",
        "difficulty": "NORMAL",
        "questionText": "「せまい」の つかいかたが いちばん よい 文は どれですか。",
        "passage": null,
        "explanationKo": "핵심: せまい = (공간이) 좁다\n길이 좁아 큰 차가 못 지나간다는 문장이 맞습니다. 케이크는 맛·크기, 키는 ひくい(작다), 일이 많은 것은 おおい·いそがしい로 말합니다.",
        "explanationJa": null,
        "tagNames": ["vocab.adjective"],
        "options": [
          {
            "clientOptionKey": "option-1",
            "text": "この ケーキは せまくて おいしいです。"
          },
          {
            "clientOptionKey": "option-2",
            "text": "あにの せは とても せまいです。"
          },
          {
            "clientOptionKey": "option-3",
            "text": "この みちは せまいので、大きな 車は とおれません。"
