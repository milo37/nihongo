      }
    },
    {
      "clientItemId": "n5-a3-vocabulary-11",
      "content": {
        "level": "N5",
        "subject": "VOCABULARY",
        "questionType": "CONTEXT_VOCABULARY",
        "difficulty": "NORMAL",
        "questionText": "ゆうびんきょくで てがみに はる（　）を かいました。（　）に 入る ことばは どれですか。",
        "passage": null,
        "explanationKo": "핵심: きって = 우표\n우체국에서 사서 편지에 붙이는 것은 きって입니다. くすり(약)·やさい(채소)·にく(고기)는 편지에 붙이지 않습니다.",
        "explanationJa": null,
        "tagNames": ["vocab.basic-noun"],
        "options": [
          {
            "clientOptionKey": "option-1",
            "text": "きって"
          },
          {
            "clientOptionKey": "option-2",
            "text": "くすり"
