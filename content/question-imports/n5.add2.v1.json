            "clientOptionKey": "option-4",
            "text": "きのうの よる コーヒーを のみました。"
          }
        ],
        "correctOptionKey": "option-1"
      }
    },
    {
      "clientItemId": "n5-a3-vocabulary-15",
      "content": {
