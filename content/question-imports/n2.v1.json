      "clientItemId": "n2-v2-vocabulary-01",
      "content": {
        "level": "N2",
        "subject": "VOCABULARY",
        "questionType": "KANJI_READING",
        "difficulty": "NORMAL",
        "questionText": "新しい制度の「導入」が決まった。「導入」の読み方はどれですか。",
        "passage": null,
        "explanationKo": "핵심: 導入 = どうにゅう(도입)\nどうにゅ는 끝의 장음이 빠졌고, とうにゅう는 탁음이 빠졌고, どうじゅう는 「入」의 읽기가 아닙니다.",
        "explanationJa": null,
        "tagNames": ["vocab.kango"],
        "options": [
          {
            "clientOptionKey": "option-1",
            "text": "どうにゅう"
          },
          {
            "clientOptionKey": "option-2",
            "text": "どうにゅ"
          },
          {
            "clientOptionKey": "option-3",
            "text": "とうにゅう"
          },
          {
            "clientOptionKey": "option-4",
            "text": "どうじゅう"
          }
        ],
        "correctOptionKey": "option-1"
      }
    },
    {
