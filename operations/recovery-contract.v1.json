{
  "schemaVersion": 1,
  "classifications": {
    "TEST": "provider-neutral-isolated-fixture",
    "STAGING": "exact-external-target-evidence",
    "PRODUCTION": "exact-external-target-evidence"
  },
  "requiredRegistryFields": [
    "database.runtimeIdentity",
    "database.migrationIdentity",
    "database.administrationIdentity",
    "database.targetFingerprint",
    "backup.capability",
    "backup.evidenceAdapter",
    "backup.rpo",
    "backup.rto",
    "backup.retention",
    "backup.restoreTarget",
    "governance.deploymentApprover",
    "governance.incidentOwner"
  ],
  "migrationProfiles": {
    "current": {
      "environments": ["TEST", "STAGING", "PRODUCTION"],
      "selection": "all-release-manifest-entries",
      "expectedCount": 8,
      "expectedDigestSha256": "cb80023c00ba100cc979c8fd9a8b0a21f1f79124d625fc4901715ffabe1fc8b0",
      "externalRecoveryClaimAllowed": false
    }
  },
  "sequence": [
    "release-manifest-verified",
    "quality-gates-green",
    "exact-backup-proof-accepted",
    "migration-profile-preflight-green",
    "migration-applied",
    "artifact-deployed",
    "liveness-green",
    "readiness-green",
    "post-deploy-smoke-green",
    "recovery-evidence-verified"
  ],
  "rollbackMatrix": [
    {
      "state": "before-migration",
      "action": "abort-without-target-write"
    },
    {
      "state": "unchanged-migration-profile",
      "action": "previous-artifact-allowed"
    },
    {
      "state": "additive-compatible-migration",
      "action": "previous-artifact-only-with-reviewed-compatibility-evidence"
    },
    {
      "state": "other-schema-change",
      "action": "forward-fix-only"
    }
  ],
  "forbiddenOperations": [
    "prisma migrate reset",
    "prisma db push",
    "prisma migrate dev",
    "reverse migration",
    "ad-hoc production sql",
    "restore over source target"
  ],
  "evidencePolicy": {
    "maximumInputBytes": 1048576,
    "identifiers": "sha256-fingerprints-only",
    "supportedVerifierEnvironments": ["TEST"],
    "externalEvidence": "disabled-until-trusted-adapter",
    "forbiddenMaterial": [
      "url",
      "credential",
      "database-name",
      "dump-or-backup-path",
      "sql",
      "provider-output",
      "private-row",
      "request-body",
      "raw-error"
    ],
    "testExternalClaims": "all-false"
  }
}
