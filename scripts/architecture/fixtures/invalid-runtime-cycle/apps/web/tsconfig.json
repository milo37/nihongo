{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@api/*": ["src/api/*"],
      "@app/*": ["src/app/*"],
      "@mocks/*": ["src/mocks/*"],
      "@provider/*": ["src/provider/*"],
      "@types/*": ["src/types/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src"]
}
