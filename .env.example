POSTGRES_DB=nihongo_dev
POSTGRES_USER=nihongo
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=55432
# The opt-in phase7-local profile uses a separate port and volume. Replace every
# blank value with a distinct `openssl rand -hex 24` value before first start.
PHASE7_POSTGRES_PORT=55433
PHASE7_TEST_MIGRATION_PASSWORD=
PHASE7_TEST_APP_PASSWORD=
PHASE7_TEST_AUTH_GATEWAY_PASSWORD=
PHASE7_TEST_ERASURE_WORKER_PASSWORD=
PHASE7_TEST_LEGACY_APP_PASSWORD=
PHASE7_DEVELOPMENT_MIGRATION_PASSWORD=
PHASE7_DEVELOPMENT_APP_PASSWORD=
PHASE7_DEVELOPMENT_AUTH_GATEWAY_PASSWORD=
PHASE7_DEVELOPMENT_ERASURE_WORKER_PASSWORD=
PHASE7_DEVELOPMENT_LEGACY_APP_PASSWORD=

# API processes read apps/api/.env(.test), not these reference URLs.
PHASE7_MIGRATION_DATABASE_URL=postgresql://nihongo_development_phase7_migration_login:replace_me_development_migration@127.0.0.1:55433/nihongo_dev?schema=public&options=-c%20role%3Dnihongo_phase7_migration
PRODUCTION_DATABASE_URL=postgresql://nihongo:replace_me@production.example.com:5432/nihongo
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3001
GUEST_COOKIE_SECRET=replace_with_a_different_32_char_secret
AUTH_GATEWAY_DATABASE_URL=postgresql://nihongo_development_auth_gateway_login:replace_me_development_auth_gateway@127.0.0.1:55433/nihongo_dev?schema=public
AUTH_EMAIL_FROM=auth@example.test
AUTH_EMAIL_DELIVERY_MODE=test-sink
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ADMIN_CMS_MODE=disabled
