{
  "name": "@nihongo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --manifest .vite/manifest.json --ssrManifest .vite/ssr-manifest.json && node scripts/built-css-check.mjs && node ../../scripts/architecture/cli.mjs && node ../../scripts/operations/browser-artifact-check.mjs web dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:request-ledger": "vitest run --config scripts/request-ledger.vitest.config.mjs",
    "test:bundle": "node scripts/production-bundle-check.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.0",
    "msw": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.0.0",
    "zod": "4.6.7",
    "zustand": "^5.1.0",
    "@nihongo/contracts": "workspace:*",
    "i18next": "26.4.2",
    "react-i18next": "17.0.15",
    "@nihongo/browser": "workspace:*"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "^5.8.0",
    "vite": "^8.3.6",
    "vitest": "4.1.12",
    "@tailwindcss/postcss": "4.3.5"
  }
}
