    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
