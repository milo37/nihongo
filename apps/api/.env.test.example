NODE_ENV=test
DEPLOYMENT_ENVIRONMENT=TEST
ADMIN_CMS_MODE=disabled
# The API runs every facade as nihongo_app through this one URL.
DATABASE_URL=postgresql://nihongo_test_app_login:replace_me_test_app@127.0.0.1:55433/nihongo_test?schema=public
# #504 P8-1: owned is the only auth runtime (the legacy runtime is gone).
MIGRATION_DATABASE_URL=postgresql://nihongo_test_migration_login:replace_me_test_migration@127.0.0.1:55433/nihongo_test?schema=public&options=-c%20role%3Dnihongo_migration
PRODUCTION_DATABASE_URL=postgresql://nihongo:replace_me@production.example.com:5432/nihongo
# The disposable integration runners own canonical wrappers on the default
# 55432 service. Never point these two URLs at postgres-phase7/55433.
DB_INTEGRATION_DATABASE_URL=postgresql://nihongo:replace_me@127.0.0.1:55432/nihongo_test?schema=public
API_INTEGRATION_DATABASE_URL=postgresql://nihongo:replace_me@127.0.0.1:55432/nihongo_test?schema=public
TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=silent
BETTER_AUTH_SECRET=test_auth_secret_that_is_at_least_32_chars
BETTER_AUTH_URL=http://localhost:3001
GUEST_COOKIE_SECRET=test_guest_secret_that_is_at_least_32_chars
AUTH_EMAIL_FROM=auth@example.test
AUTH_EMAIL_DELIVERY_MODE=test-sink
