NODE_ENV=test
ADMIN_CMS_MODE=disabled
DATABASE_URL=postgresql://nihongo_test_legacy_app_login:replace_me_test_legacy@127.0.0.1:55433/nihongo_test?schema=public
# ADMIN_CMS_MODE=disabled uses the activation-pre legacy app login above.
# For technical startup, set ADMIN_CMS_MODE=technical and replace DATABASE_URL
# with the nihongo_test_app_login URL documented in README.md.
PHASE7_MIGRATION_DATABASE_URL=postgresql://nihongo_test_phase7_migration_login:replace_me_test_migration@127.0.0.1:55433/nihongo_test?schema=public&options=-c%20role%3Dnihongo_phase7_migration
AUTH_GATEWAY_DATABASE_URL=postgresql://nihongo_test_auth_gateway_login:replace_me_test_auth_gateway@127.0.0.1:55433/nihongo_test?schema=public
PRODUCTION_DATABASE_URL=postgresql://nihongo:replace_me@production.example.com:5432/nihongo
# The disposable integration runners own canonical wrappers on the default
# 55432 service. Never point these two URLs at postgres-phase7/55433.
PHASE7_INTEGRATION_DATABASE_URL=postgresql://nihongo:replace_me@127.0.0.1:55432/nihongo_test?schema=public
PHASE7_API_INTEGRATION_DATABASE_URL=postgresql://nihongo:replace_me@127.0.0.1:55432/nihongo_test?schema=public
TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=silent
BETTER_AUTH_SECRET=test_auth_secret_that_is_at_least_32_chars
BETTER_AUTH_URL=http://localhost:3001
GUEST_COOKIE_SECRET=test_guest_secret_that_is_at_least_32_chars
AUTH_EMAIL_FROM=auth@example.test
AUTH_EMAIL_DELIVERY_MODE=test-sink
