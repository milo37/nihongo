NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=LOCAL
ADMIN_CMS_MODE=disabled
HOST=127.0.0.1
PORT=3001
# The API runs every facade as nihongo_app through this one URL.
DATABASE_URL=postgresql://nihongo_development_app_login:replace_me_development_app@127.0.0.1:55433/nihongo_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://nihongo_development_migration_login:replace_me_development_migration@127.0.0.1:55433/nihongo_dev?schema=public&options=-c%20role%3Dnihongo_migration
PRODUCTION_DATABASE_URL=postgresql://nihongo:replace_me@production.example.com:5432/nihongo
TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3001
GUEST_COOKIE_SECRET=replace_with_a_different_32_char_secret
AUTH_EMAIL_FROM=auth@example.test
AUTH_EMAIL_DELIVERY_MODE=test-sink
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
PRACTICE_CONTRACT_RUNTIME=v1-v2
