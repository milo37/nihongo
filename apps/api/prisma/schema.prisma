generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestionLifecycleStatus {
  ACTIVE
  ARCHIVED
}

enum QuestionVersionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  RETIRED
}

enum RetirementKind {
  PUBLISHED_RETIREMENT
  AUTHOR_ERASURE_ABANDONED
  QUESTION_ARCHIVE_ABANDONED
}

enum AccountActorLabel {
  ACTIVE_USER
  DELETED_USER
  ACTIVE_ADMIN
  DELETED_ADMIN
}

enum EvidenceActorKind {
  ACCOUNT
  SYSTEM
}

enum EvidenceActorRole {
  USER
  ADMIN
  SYSTEM
}

enum SystemActorLabel {
  ACCOUNT_ERASURE
}

enum ContentReviewAction {
  REQUESTED
  CHANGES_REQUESTED
  APPROVED
  APPROVAL_WITHDRAWN
  PUBLISHED
  RETIRED
  ARCHIVE_ABANDONED
  AUTHOR_ERASURE_ABANDONED
}

enum AdminAuditCommand {
  QUESTION_CREATE
  QUESTION_VERSION_CREATE
  QUESTION_VERSION_UPDATE
  REVIEW_REQUEST
  CHANGE_REQUEST
  APPROVAL
  APPROVAL_WITHDRAWAL
  PUBLICATION
  RETIREMENT
  QUESTION_ARCHIVE
  REVIEW_REQUEST_BATCH
  IMPORT_APPLY
  EXPORT
  REPORT_TRIAGE
  REPORT_RESOLUTION
  REAUTHENTICATION
  AUTHOR_ERASURE_ABANDON
}

enum AdminAuditTargetType {
  QUESTION
  QUESTION_VERSION
  QUESTION_REPORT
  REVIEW_REQUEST_BATCH
  IMPORT_REQUEST
  EXPORT_REQUEST
  ADMIN_SESSION
  USER_ERASURE
}

enum AdminAuditEnvironment {
  TEST
  DEVELOPMENT
}

enum QuestionReportReason {
  ANSWER_ERROR
  EXPLANATION_ERROR
  TYPO_OR_GRAMMAR
  AMBIGUOUS
  LEVEL_OR_TAXONOMY
  OTHER
}

enum QuestionReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISMISSED
}

enum QuestionReportResolutionOutcome {
  RESOLVED
  DISMISSED
}

enum AuthSessionFamilyStatus {
  ACTIVE
  REVOKED
}

enum AuthSessionIssuerProtocolVersion {
  LEGACY
  PHASE7_V1
}

enum AuthSessionAuthorizationState {
  ACTIVE
  PENDING_REAUTH
}

enum Phase7ReauthenticationIntentState {
  PREPARED
  STAGED
  FINALIZED
}

enum Phase7AuthorityRevocationReason {
  ADMIN_AUTHORITY_LOST
  SESSION_INVALIDATED
}

enum AuthVerificationPurpose {
  PASSWORD_RESET_V1
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum QuestionSubject {
  VOCABULARY
  GRAMMAR
  READING
}

enum QuestionType {
  KANJI_READING
  ORTHOGRAPHY
  CONTEXT_VOCABULARY
  PARAPHRASE
  WORD_USAGE
  GRAMMAR_SELECT
  SENTENCE_ORDER
  TEXT_GRAMMAR
  SHORT_READING
  MEDIUM_READING
  LONG_READING
  INFO_RETRIEVAL
}

enum QuestionDifficulty {
  EASY
  NORMAL
  HARD
}

enum QuestionSourceType {
  ORIGINAL
}

enum CreatorLabelSnapshot {
  ACTIVE_ADMIN
  DELETED_ADMIN
  SYSTEM_SEED
}

enum UserRole {
  USER
  ADMIN
}

enum UserAccountStatus {
  ACTIVE
  DELETION_PENDING
  DELETED
}

enum StudyMode {
  RANDOM
  WRONG_NOTE
  WEAKNESS
  BOOKMARK
  DAILY_REVIEW
}

enum StudySessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum StudySessionFallbackReason {
  INSUFFICIENT_ELIGIBLE_QUESTIONS
  INSUFFICIENT_MODE_CANDIDATES
}

enum WrongNoteStatus {
  NEW
  REVIEWING
  AGAIN
  SOLVED
}

enum ReviewEventSource {
  STUDY_SUBMIT
  WRONG_NOTE_REVIEW
  VERSION_REBASE
}

enum IdempotencyPrincipalType {
  USER
  GUEST
}

enum IdempotencyOperation {
  STUDY_SUBMIT
  STUDY_DRAFT_SAVE
  STUDY_RETRY_CREATE
  STUDY_TARGETED_REVIEW_CREATE
}

enum IdempotencyState {
  PROCESSING
  SUCCEEDED
}

model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String                     @db.VarChar(80)
  email                     String                     @unique
  emailVerified             Boolean                    @default(false)
  image                     String?
  role                      UserRole                   @default(USER)
  targetLevel               JlptLevel?
  accountStatus             UserAccountStatus          @default(ACTIVE)
  authorityGeneration       Int                        @default(dbgenerated("1"))
  deletedAt                 DateTime?                  @db.Timestamptz(3)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  sessions                  Session[]
  sessionFamilies           AuthSessionFamily[]
  sessionRotationFences     AuthSessionRotationFence[]
  accounts                  Account[]
  resetVerifications        Verification[]             @relation("PasswordResetUser")
  createdQuestions          Question[]                 @relation("QuestionCreator")
  createdQuestionVersions   QuestionVersion[]          @relation("QuestionVersionCreator")
  contentReviewActors       ContentReview[]            @relation("ContentReviewActor")
  contentReviewCounterparts ContentReview[]            @relation("ContentReviewCounterpart")
  adminAuditActors          AdminAuditLog[]            @relation("AdminAuditActor")
  submittedQuestionReports  QuestionReport[]           @relation("QuestionReportReporter")
  assignedQuestionReports   QuestionReport[]           @relation("QuestionReportAssignee")
  studySessions             StudySession[]
  wrongNotes                WrongNote[]
  bookmarks                 Bookmark[]
  idempotencyRecords        IdempotencyRecord[]

  @@index([role, accountStatus])
}

model Session {
  id                    String                           @id @default(uuid()) @db.Uuid
  expiresAt             DateTime                         @db.Timestamptz(3)
  token                 String                           @unique
  createdAt             DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                         @updatedAt @db.Timestamptz(3)
  ipAddress             String?
  userAgent             String?
  userId                String                           @db.Uuid
  sessionFamilyId       String                           @default(dbgenerated("public.gen_random_uuid()")) @db.Uuid
  authorityGeneration   Int                              @default(dbgenerated("1"))
  issuerProtocolVersion AuthSessionIssuerProtocolVersion @default(dbgenerated("'LEGACY'::\"AuthSessionIssuerProtocolVersion\""))
  authorizationState    AuthSessionAuthorizationState    @default(dbgenerated("'ACTIVE'::\"AuthSessionAuthorizationState\""))
  user                  User                             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessionFamily         AuthSessionFamily                @relation(fields: [userId, sessionFamilyId], references: [userId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, sessionFamilyId, id])
  @@index([userId, sessionFamilyId, expiresAt])
  @@index([userId, issuerProtocolVersion, expiresAt])
  @@index([expiresAt])
}

model AuthIssuerActivation {
  id                   Int      @id @default(1) @db.SmallInt
  legacyIssuerDisabled Boolean  @default(false)
  updatedAt            DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
}

model AuthSessionFamily {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @db.Uuid
  status            AuthSessionFamilyStatus    @default(ACTIVE)
  createdAt         DateTime                   @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  revokedAt         DateTime?                  @db.Timestamptz(3)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sessions          Session[]
  oldFences         AuthSessionRotationFence[] @relation("RotationFenceOldFamily")
  replacementFences AuthSessionRotationFence[] @relation("RotationFenceReplacementFamily")

  @@unique([userId, id])
  @@index([userId, status, id])
}

model AuthSessionRotationFence {
  id                   String            @id @default(dbgenerated("public.gen_random_uuid()")) @db.Uuid
  oldSessionId         String            @unique @db.Uuid
  oldTokenDigest       String            @unique @db.VarChar(64)
  userId               String            @db.Uuid
  oldFamilyId          String            @db.Uuid
  replacementFamilyId  String            @db.Uuid
  replacementSessionId String            @db.Uuid
  operationId          String            @unique @db.Uuid
  createdAt            DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  expiresAt            DateTime          @db.Timestamptz(3)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  oldFamily            AuthSessionFamily @relation("RotationFenceOldFamily", fields: [userId, oldFamilyId], references: [userId, id], onDelete: Restrict, onUpdate: NoAction)
  replacementFamily    AuthSessionFamily @relation("RotationFenceReplacementFamily", fields: [userId, replacementFamilyId], references: [userId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([replacementFamilyId, expiresAt])
}

// Transaction-local Phase 7 authority/evidence state. These tables are part of
// migration drift control but intentionally excluded from Prisma Client so
// application code cannot treat their rows as a public persistence API.
model Phase7OperationIntent {
  operationId                 String                 @id @db.Uuid
  requestId                   String                 @db.Uuid
  command                     AdminAuditCommand
  actorUserId                 String?                @db.Uuid
  actorSessionId              String?                @db.Uuid
  actorFamilyId               String?                @db.Uuid
  capturedAuthorityGeneration Int?
  referencedUserIds           String[]               @db.Uuid
  targetManifest              Json?                  @db.JsonB
  requiresFresh               Boolean                @default(false)
  environment                 AdminAuditEnvironment
  occurredAt                  DateTime?              @db.Timestamptz(3)
  backendPid                  Int
  transactionId               BigInt
  deltas                      Phase7OperationDelta[]

  @@unique([backendPid, transactionId], map: "Phase7OperationIntent_backend_transaction_key")
  @@ignore
}

model Phase7OperationDelta {
  operationId      String                @db.Uuid
  entityType       String
  targetId         String                @db.Uuid
  questionId       String?               @db.Uuid
  mutation         String
  fromState        String?
  toState          String?
  beforeRowVersion Int?
  afterRowVersion  Int?
  beforeSnapshot   Json?                 @db.JsonB
  afterSnapshot    Json?                 @db.JsonB
  intent           Phase7OperationIntent @relation(fields: [operationId], references: [operationId], onDelete: Cascade, onUpdate: NoAction)

  @@id([operationId, entityType, targetId])
  @@ignore
}

model Phase7TrustedExecution {
  id              String                 @id @default(dbgenerated("public.gen_random_uuid()")) @db.Uuid
  kind            String
  targetUserId    String?                @db.Uuid
  rememberSession Boolean?
  environment     AdminAuditEnvironment?
  backendPid      Int
  transactionId   BigInt
  createdAt       DateTime               @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  @@unique([backendPid, transactionId, kind], map: "Phase7TrustedExecution_context_key")
  @@ignore
}

model Phase7DatabaseCapability {
  id            Int                   @id @default(1) @db.SmallInt
  databaseName  String
  serverAddress String                @db.Inet
  serverPort    Int
  environment   AdminAuditEnvironment
  registeredAt  DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  @@ignore
}

model Phase7ReauthenticationIntent {
  id                          String                            @id @default(dbgenerated("public.gen_random_uuid()")) @db.Uuid
  operationId                 String                            @unique @default(dbgenerated("public.gen_random_uuid()")) @db.Uuid
  requestId                   String                            @db.Uuid
  userId                      String                            @db.Uuid
  oldSessionId                String                            @db.Uuid
  oldTokenDigest              String                            @db.VarChar(64)
  oldFenceTokenDigest         String                            @db.VarChar(64)
  sessionFamilyId             String                            @db.Uuid
  capturedAuthorityGeneration Int
  capturedRole                UserRole
  capturedAccountStatus       UserAccountStatus
  state                       Phase7ReauthenticationIntentState @default(PREPARED)
  stagedSessionId             String?                           @unique @db.Uuid
  stagedTokenDigest           String?                           @unique @db.VarChar(64)
  environment                 AdminAuditEnvironment
  createdAt                   DateTime                          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  expiresAt                   DateTime                          @db.Timestamptz(3)
  finalizedAt                 DateTime?                         @db.Timestamptz(3)

  @@index([state, expiresAt, id])
  @@index([userId, sessionFamilyId, state])
  @@ignore
}

model Phase7AuthorityRevocationEvidence {
  tokenDigest String                          @id @db.VarChar(64)
  sessionId   String                          @db.Uuid
  familyId    String                          @db.Uuid
  reason      Phase7AuthorityRevocationReason
  createdAt   DateTime                        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  expiresAt   DateTime                        @db.Timestamptz(3)

  @@index([expiresAt, tokenDigest])
  @@ignore
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id                 String                   @id @default(uuid()) @db.Uuid
  identifier         String
  value              String
  expiresAt          DateTime                 @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  purpose            AuthVerificationPurpose?
  resetUserId        String?                  @db.Uuid
  capturedGeneration Int?
  tokenSelector      String?                  @unique @db.VarChar(64)
  resetUser          User?                    @relation("PasswordResetUser", fields: [resetUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([purpose, resetUserId])
  @@index([identifier, expiresAt])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model GuestPrincipal {
  id                 String              @id @default(uuid()) @db.Uuid
  tokenDigest        String              @unique @db.VarChar(64)
  expiresAt          DateTime            @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  lastSeenAt         DateTime            @default(now()) @db.Timestamptz(3)
  studySessions      StudySession[]
  idempotencyRecords IdempotencyRecord[]

  @@index([expiresAt])
}

model StudySession {
  id                       String                      @id @default(uuid()) @db.Uuid
  userId                   String?                     @db.Uuid
  guestPrincipalId         String?                     @db.Uuid
  retryOfStudySessionId    String?                     @db.Uuid
  level                    JlptLevel
  subject                  QuestionSubject
  mode                     StudyMode
  status                   StudySessionStatus          @default(IN_PROGRESS)
  requestedCount           Int
  actualCount              Int
  usedFallback             Boolean                     @default(false)
  fallbackReason           StudySessionFallbackReason?
  startedAt                DateTime                    @default(now()) @db.Timestamptz(3)
  expiresAt                DateTime                    @db.Timestamptz(3)
  submittedAt              DateTime?                   @db.Timestamptz(3)
  cancelledAt              DateTime?                   @db.Timestamptz(3)
  durationSec              Int?
  submissionHash           String?                     @db.VarChar(64)
  practiceContractVersion  Int                         @default(1)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @db.Timestamptz(3)
  user                     User?                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guestPrincipal           GuestPrincipal?             @relation(fields: [guestPrincipalId], references: [id], onDelete: Cascade)
  retryOfStudySession      StudySession?               @relation("StudySessionRetry", fields: [retryOfStudySessionId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  retrySessions            StudySession[]              @relation("StudySessionRetry")
  retryOfUserStudySession  StudySession?               @relation("StudySessionRetryUser", fields: [retryOfStudySessionId, userId], references: [id, userId], onDelete: NoAction, onUpdate: Cascade, map: "StudySession_retryOfStudySessionId_userId_fkey")
  retryUserSessions        StudySession[]              @relation("StudySessionRetryUser")
  retryOfGuestStudySession StudySession?               @relation("StudySessionRetryGuest", fields: [retryOfStudySessionId, guestPrincipalId], references: [id, guestPrincipalId], onDelete: NoAction, onUpdate: Cascade, map: "StudySession_retryOfStudySessionId_guestPrincipalId_fkey")
  retryGuestSessions       StudySession[]              @relation("StudySessionRetryGuest")
  questions                StudySessionQuestion[]
  result                   StudyResult?
  reviewEvents             ReviewEvent[]
  idempotencyRecords       IdempotencyRecord[]
  userIdempotencyRecords   IdempotencyRecord[]         @relation("IdempotencyStudySessionUser")
  guestIdempotencyRecords  IdempotencyRecord[]         @relation("IdempotencyStudySessionGuest")
  draft                    StudyDraft?

  @@unique([id, userId])
  @@unique([id, guestPrincipalId])
  @@index([userId, status, startedAt(sort: Desc)])
  @@index([guestPrincipalId, status, expiresAt])
  @@index([guestPrincipalId, status, submittedAt])
  @@index([retryOfStudySessionId, id])
  @@index([status, expiresAt])
}

model StudySessionQuestion {
  id                 String             @id @default(uuid()) @db.Uuid
  studySessionId     String             @db.Uuid
  questionId         String             @db.Uuid
  questionVersionId  String             @db.Uuid
  ordinal            Int
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  studySession       StudySession       @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  question           Question           @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion    QuestionVersion    @relation(fields: [questionId, questionVersionId], references: [questionId, id], onDelete: Restrict)
  answer             StudyAnswer?
  draftAnswer        StudyDraftAnswer?  @relation("StudyDraftAnswerSessionQuestion")
  pinnedDraftAnswers StudyDraftAnswer[] @relation("StudyDraftAnswerPinnedQuestion")

  @@unique([studySessionId, ordinal])
  @@unique([studySessionId, questionId])
  @@unique([studySessionId, questionVersionId])
  @@unique([id, questionVersionId])
  @@unique([studySessionId, id])
  @@index([questionId, questionVersionId])
}

model StudyDraft {
  studySessionId String             @id @db.Uuid
  revision       Int                @default(0)
  currentOrdinal Int                @default(1)
  savedAt        DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @db.Timestamptz(3)
  studySession   StudySession       @relation(fields: [studySessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  answers        StudyDraftAnswer[]

  @@index([savedAt(sort: Desc), studySessionId], map: "StudyDraft_savedAt_studySessionId_idx")
}

model StudyDraftAnswer {
  studySessionId         String               @db.Uuid
  studySessionQuestionId String               @db.Uuid
  questionVersionId      String               @db.Uuid
  selectedOptionId       String?              @db.Uuid
  elapsedSec             Int                  @default(0)
  updatedAt              DateTime             @db.Timestamptz(3)
  draft                  StudyDraft           @relation(fields: [studySessionId], references: [studySessionId], onDelete: Cascade, onUpdate: Cascade)
  studySessionQuestion   StudySessionQuestion @relation("StudyDraftAnswerSessionQuestion", fields: [studySessionId, studySessionQuestionId], references: [studySessionId, id], onDelete: Cascade, onUpdate: Cascade)
  pinnedSessionQuestion  StudySessionQuestion @relation("StudyDraftAnswerPinnedQuestion", fields: [studySessionQuestionId, questionVersionId], references: [id, questionVersionId], onDelete: Cascade, onUpdate: Cascade)
  selectedOption         QuestionOption?      @relation("StudyDraftAnswerSelectedOption", fields: [questionVersionId, selectedOptionId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: Cascade)

  @@id([studySessionId, studySessionQuestionId])
  @@index([studySessionQuestionId, questionVersionId])
}

model Question {
  id                        String                  @id @default(uuid()) @db.Uuid
  lifecycleStatus           QuestionLifecycleStatus @default(ACTIVE)
  currentPublishedVersionId String?                 @unique @db.Uuid
  createdByUserId           String?                 @db.Uuid
  createdByActorId          String?                 @db.Uuid
  createdByRoleSnapshot     UserRole?
  createdByLabelSnapshot    CreatorLabelSnapshot
  rowVersion                Int                     @default(dbgenerated("1"))
  createdAt                 DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(3)
  archivedAt                DateTime?               @db.Timestamptz(3)
  versions                  QuestionVersion[]       @relation("QuestionVersions")
  createdBy                 User?                   @relation("QuestionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentPublishedVersion   QuestionVersion?        @relation("CurrentPublishedVersion", fields: [id, currentPublishedVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: NoAction)
  studySessionQuestions     StudySessionQuestion[]
  wrongNotes                WrongNote[]
  bookmarks                 Bookmark[]
  contentReviews            ContentReview[]
  questionReports           QuestionReport[]

  @@unique([id, currentPublishedVersionId])
  @@index([lifecycleStatus, currentPublishedVersionId])
  @@index([createdByUserId])
}

model Bookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  questionId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, questionId])
  @@index([userId, createdAt(sort: Desc), id])
  @@index([userId, createdAt(sort: Desc), questionId])
  @@index([questionId, id])
}

model QuestionVersion {
  id                         String                 @id @default(uuid()) @db.Uuid
  questionId                 String                 @db.Uuid
  versionNumber              Int
  status                     QuestionVersionStatus  @default(DRAFT)
  level                      JlptLevel
  subject                    QuestionSubject
  questionType               QuestionType
  passage                    String?
  questionText               String
  correctOptionId            String                 @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
  explanationKo              String
  explanationJa              String?
  difficulty                 QuestionDifficulty
  sourceType                 QuestionSourceType     @default(ORIGINAL)
  rowVersion                 Int                    @default(1)
  createdByUserId            String?                @db.Uuid
  createdByActorId           String?                @db.Uuid
  createdByRoleSnapshot      UserRole?
  createdByLabelSnapshot     CreatorLabelSnapshot
  retirementKind             RetirementKind?
  contentFingerprint         String                 @default(dbgenerated("repeat('0'::text, 64)")) @db.VarChar(64)
  createdAt                  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @db.Timestamptz(3)
  publishedAt                DateTime?              @db.Timestamptz(3)
  retiredAt                  DateTime?              @db.Timestamptz(3)
  question                   Question               @relation("QuestionVersions", fields: [questionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy                  User?                  @relation("QuestionVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentForQuestion         Question?              @relation("CurrentPublishedVersion")
  correctOption              QuestionOption         @relation("CorrectQuestionOption", fields: [id, correctOptionId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: NoAction)
  options                    QuestionOption[]       @relation("VersionOptions")
  tags                       QuestionVersionTag[]
  studySessionQuestions      StudySessionQuestion[]
  lastWrongNotes             WrongNote[]            @relation("WrongNoteLastWrongVersion")
  currentReviewWrongNotes    WrongNote[]            @relation("WrongNoteCurrentReviewVersion")
  reviewEvents               ReviewEvent[]
  contentReviews             ContentReview[]
  targetQuestionReports      QuestionReport[]       @relation("QuestionReportTargetVersion")
  remediationQuestionReports QuestionReport[]       @relation("QuestionReportRemediationVersion")

  @@unique([questionId, versionNumber])
  @@unique([questionId, id])
  @@unique([id, correctOptionId])
  @@index([status, level, subject, questionType, difficulty])
  @@index([questionId, status, versionNumber(sort: Desc)])
  @@index([questionId, versionNumber(sort: Desc), id(sort: Desc)])
  @@index([contentFingerprint])
  // The migration-owned index also fixes COLLATE "C"; Prisma cannot model a
  // per-index-key collation, so the Phase 7 drift gate verifies pg_get_indexdef.
  @@index([questionText(ops: raw("text_pattern_ops"))], map: "QuestionVersion_questionText_prefix_idx")
  @@index([createdByUserId])
}

model QuestionOption {
  id                String             @id @default(uuid()) @db.Uuid
  questionVersionId String             @db.Uuid
  label             String
  text              String
  ordinal           Int
  questionVersion   QuestionVersion    @relation("VersionOptions", fields: [questionVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  correctForVersion QuestionVersion?   @relation("CorrectQuestionOption")
  selectedByAnswers StudyAnswer[]      @relation("StudyAnswerSelectedOption")
  selectedByEvents  ReviewEvent[]      @relation("ReviewEventSelectedOption")
  selectedByDrafts  StudyDraftAnswer[] @relation("StudyDraftAnswerSelectedOption")

  @@unique([questionVersionId, id])
  @@unique([questionVersionId, label])
  @@unique([questionVersionId, ordinal])
}

model Tag {
  id             String               @id @default(uuid()) @db.Uuid
  label          String
  normalizedName String               @unique
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  versions       QuestionVersionTag[]
  applicability  TagApplicability[]
}

model QuestionVersionTag {
  id                     String          @id @default(uuid()) @db.Uuid
  questionVersionId      String          @db.Uuid
  tagId                  String          @db.Uuid
  labelSnapshot          String
  normalizedNameSnapshot String          @default(dbgenerated("''::text"))
  questionVersion        QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tag                    Tag             @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([questionVersionId, tagId])
  @@unique([questionVersionId, normalizedNameSnapshot])
  @@index([tagId])
}

model TagApplicability {
  tagId        String          @db.Uuid
  level        JlptLevel
  subject      QuestionSubject
  questionType QuestionType
  tag          Tag             @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([tagId, level, subject, questionType])
  @@index([level, subject, questionType, tagId], map: "TagApplicability_taxonomy_idx")
}

model ContentReview {
  id                 String                @id @default(dbgenerated("public.gen_random_uuid()")) @db.Uuid
  questionId         String                @db.Uuid
  questionVersionId  String                @db.Uuid
  action             ContentReviewAction
  fromState          QuestionVersionStatus
  toState            QuestionVersionStatus
  actorKind          EvidenceActorKind
  actorUserId        String?               @db.Uuid
  actorId            String?               @db.Uuid
  actorRole          EvidenceActorRole
  actorLabel         AccountActorLabel?
  actorSystemLabel   SystemActorLabel?
  counterpartUserId  String?               @db.Uuid
  counterpartActorId String?               @db.Uuid
  counterpartRole    UserRole?
  counterpartLabel   AccountActorLabel?
  reason             String?               @db.VarChar(100)
  comment            String?               @db.VarChar(1000)
  operationId        String                @db.Uuid
  requestId          String                @db.Uuid
  occurredAt         DateTime              @db.Timestamptz(3)
  question           Question              @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  questionVersion    QuestionVersion       @relation(fields: [questionId, questionVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: NoAction)
  actorUser          User?                 @relation("ContentReviewActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  counterpartUser    User?                 @relation("ContentReviewCounterpart", fields: [counterpartUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([operationId, questionVersionId], map: "ContentReview_operation_version_key")
  @@index([questionVersionId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([operationId])
}

model AdminAuditLog {
  id               String                @id @default(dbgenerated("public.gen_random_uuid()")) @db.Uuid
  command          AdminAuditCommand
  targetType       AdminAuditTargetType
  targetId         String                @db.Uuid
  actorKind        EvidenceActorKind
  actorUserId      String?               @db.Uuid
  actorId          String?               @db.Uuid
  actorRole        EvidenceActorRole
  actorLabel       AccountActorLabel?
  actorSystemLabel SystemActorLabel?
  beforeState      String?               @db.VarChar(64)
  afterState       String?               @db.VarChar(64)
  beforeRowVersion Int?
  afterRowVersion  Int?
  changedFields    Json                  @db.JsonB
  metadata         Json                  @db.JsonB
  contentDigest    String                @db.VarChar(64)
  operationId      String                @db.Uuid
  requestId        String                @db.Uuid
  environment      AdminAuditEnvironment
  occurredAt       DateTime              @db.Timestamptz(3)
  actorUser        User?                 @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([operationId])
  @@index([targetType, targetId])
}

model QuestionReport {
  id                   String                           @id @default(dbgenerated("public.gen_random_uuid()")) @db.Uuid
  questionId           String                           @db.Uuid
  questionVersionId    String                           @db.Uuid
  reason               QuestionReportReason
  description          String?
  descriptionDigest    String                           @db.VarChar(64)
  status               QuestionReportStatus             @default(OPEN)
  reporterUserId       String?                          @db.Uuid
  reporterActorId      String                           @db.Uuid
  reporterRole         UserRole
  reporterLabel        AccountActorLabel
  assigneeUserId       String?                          @db.Uuid
  assigneeActorId      String?                          @db.Uuid
  assigneeRole         UserRole?
  assigneeLabel        AccountActorLabel?
  resolutionOutcome    QuestionReportResolutionOutcome?
  resolutionReason     String?                          @db.VarChar(1000)
  remediationVersionId String?                          @db.Uuid
  rowVersion           Int                              @default(1)
  createdAt            DateTime                         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  updatedAt            DateTime                         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  resolvedAt           DateTime?                        @db.Timestamptz(3)
  question             Question                         @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  questionVersion      QuestionVersion                  @relation("QuestionReportTargetVersion", fields: [questionId, questionVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: NoAction)
  remediationVersion   QuestionVersion?                 @relation("QuestionReportRemediationVersion", fields: [questionId, remediationVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: NoAction)
  reporterUser         User?                            @relation("QuestionReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assigneeUser         User?                            @relation("QuestionReportAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([questionId, status])
  @@index([reporterActorId, questionVersionId, reason])
}

model StudyAnswer {
  id                     String               @id @default(uuid()) @db.Uuid
  studySessionQuestionId String               @unique @db.Uuid
  questionVersionId      String               @db.Uuid
  selectedOptionId       String?              @db.Uuid
  isCorrect              Boolean
  elapsedSec             Int
  gradingVersion         String               @db.VarChar(64)
  answeredAt             DateTime             @db.Timestamptz(3)
  gradedAt               DateTime             @db.Timestamptz(3)
  studySessionQuestion   StudySessionQuestion @relation(fields: [studySessionQuestionId, questionVersionId], references: [id, questionVersionId], onDelete: Cascade, onUpdate: Cascade)
  selectedOption         QuestionOption?      @relation("StudyAnswerSelectedOption", fields: [questionVersionId, selectedOptionId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: Cascade)
  reviewEvent            ReviewEvent?

  @@unique([studySessionQuestionId, questionVersionId])
  @@unique([id, questionVersionId])
  @@index([questionVersionId, selectedOptionId])
}

model StudyResult {
  id                     String       @id @default(uuid()) @db.Uuid
  studySessionId         String       @unique @db.Uuid
  totalCount             Int
  correctCount           Int
  incorrectCount         Int
  correctRateBasisPoints Int
  durationSec            Int
  gradingVersion         String       @db.VarChar(64)
  createdAt              DateTime     @db.Timestamptz(3)
  studySession           StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model WrongNote {
  id                             String           @id @default(uuid()) @db.Uuid
  userId                         String           @db.Uuid
  questionId                     String           @db.Uuid
  lastWrongQuestionVersionId     String           @db.Uuid
  currentReviewQuestionVersionId String?          @db.Uuid
  wrongCount                     Int
  correctStreak                  Int
  status                         WrongNoteStatus
  lastWrongAt                    DateTime         @db.Timestamptz(3)
  lastReviewedAt                 DateTime?        @db.Timestamptz(3)
  createdAt                      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime         @updatedAt @db.Timestamptz(3)
  user                           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question                       Question         @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastWrongQuestionVersion       QuestionVersion  @relation("WrongNoteLastWrongVersion", fields: [questionId, lastWrongQuestionVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: Cascade)
  currentReviewQuestionVersion   QuestionVersion? @relation("WrongNoteCurrentReviewVersion", fields: [questionId, currentReviewQuestionVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: Cascade)
  schedule                       ReviewSchedule?
  events                         ReviewEvent[]
  memo                           UserMemo?

  @@unique([userId, questionId])
  @@unique([id, userId, questionId])
  @@index([userId, status, lastWrongAt(sort: Desc)])
  @@index([userId, status, lastWrongAt(sort: Desc), wrongCount(sort: Desc), questionId], map: "WrongNote_user_status_lastWrongAt_wrongCount_questionId_idx")
  @@index([userId, status, id, questionId], map: "WrongNote_userId_status_id_questionId_daily_idx")
  @@index([userId, lastWrongAt(sort: Desc)])
  @@index([userId, wrongCount(sort: Desc), lastWrongAt(sort: Desc), id])
  @@index([questionId, lastWrongQuestionVersionId])
  @@index([questionId, currentReviewQuestionVersionId])
}

model UserMemo {
  id          String    @id @default(uuid()) @db.Uuid
  wrongNoteId String    @unique @db.Uuid
  text        String    @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @db.Timestamptz(3)
  wrongNote   WrongNote @relation(fields: [wrongNoteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ReviewSchedule {
  id               String    @id @default(uuid()) @db.Uuid
  wrongNoteId      String    @unique @db.Uuid
  nextReviewAt     DateTime  @db.Timestamptz(3)
  intervalDays     Int
  algorithmVersion Int
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  wrongNote        WrongNote @relation(fields: [wrongNoteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([nextReviewAt, wrongNoteId])
}

model ReviewEvent {
  id                    String            @id @default(uuid()) @db.Uuid
  wrongNoteId           String            @db.Uuid
  userId                String            @db.Uuid
  questionId            String            @db.Uuid
  questionVersionId     String            @db.Uuid
  source                ReviewEventSource
  studySessionId        String?           @db.Uuid
  studyAnswerId         String?           @unique @db.Uuid
  selectedOptionId      String?           @db.Uuid
  isCorrect             Boolean?
  previousStatus        WrongNoteStatus?
  nextStatus            WrongNoteStatus
  previousCorrectStreak Int?
  nextCorrectStreak     Int
  previousWrongCount    Int?
  wrongCountAfter       Int
  algorithmVersion      Int
  occurredAt            DateTime          @db.Timestamptz(3)
  wrongNote             WrongNote         @relation(fields: [wrongNoteId, userId, questionId], references: [id, userId, questionId], onDelete: Cascade, onUpdate: Cascade)
  questionVersion       QuestionVersion   @relation(fields: [questionId, questionVersionId], references: [questionId, id], onDelete: Restrict, onUpdate: Cascade)
  studySession          StudySession?     @relation(fields: [studySessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyAnswer           StudyAnswer?      @relation(fields: [studyAnswerId, questionVersionId], references: [id, questionVersionId], onDelete: Cascade, onUpdate: Cascade)
  selectedOption        QuestionOption?   @relation("ReviewEventSelectedOption", fields: [questionVersionId, selectedOptionId], references: [questionVersionId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([studyAnswerId, questionVersionId])
  @@index([wrongNoteId, occurredAt(sort: Desc)])
  @@index([wrongNoteId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([questionId, questionVersionId])
  @@index([studySessionId])
  @@index([questionVersionId, selectedOptionId])
}

model IdempotencyRecord {
  id                String                   @id @default(uuid()) @db.Uuid
  principalType     IdempotencyPrincipalType
  userId            String?                  @db.Uuid
  guestPrincipalId  String?                  @db.Uuid
  operation         IdempotencyOperation
  idempotencyKey    String                   @db.Uuid
  studySessionId    String                   @db.Uuid
  requestHash       String                   @db.VarChar(64)
  contractVersion   Int                      @default(1)
  state             IdempotencyState         @default(PROCESSING)
  responseStatus    Int?
  responseBody      Json?                    @db.JsonB
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?                @db.Timestamptz(3)
  expiresAt         DateTime?                @db.Timestamptz(3)
  user              User?                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guestPrincipal    GuestPrincipal?          @relation(fields: [guestPrincipalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studySession      StudySession             @relation(fields: [studySessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userStudySession  StudySession?            @relation("IdempotencyStudySessionUser", fields: [studySessionId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade, map: "IdempotencyRecord_studySessionId_userId_fkey")
  guestStudySession StudySession?            @relation("IdempotencyStudySessionGuest", fields: [studySessionId, guestPrincipalId], references: [id, guestPrincipalId], onDelete: Cascade, onUpdate: Cascade, map: "IdempotencyRecord_studySessionId_guestPrincipalId_fkey")

  @@index([studySessionId, requestHash])
}
