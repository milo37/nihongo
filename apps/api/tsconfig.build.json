{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.integration.test.ts",
    "src/e2e/**",
    "src/content/cli.ts",
    "src/content/commands/**",
    "src/db/fixtures/**",
    "src/db/phase7SsoTestFixture.ts",
    "src/db/phase7FoundationDiagnostics.ts"
  ]
}
