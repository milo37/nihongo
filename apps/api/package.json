{
  "name": "@nihongo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma/migrations"
  ],
  "scripts": {
    "dev": "pnpm run db:generate && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "pnpm run db:generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run db:generate && tsc --noEmit",
    "test": "pnpm run db:generate && vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "pnpm run db:generate && vitest",
    "test:integration": "pnpm run db:generate && vitest run --config vitest.integration.config.ts",
    "test:api-regression": "tsx src/e2e/runAdminApiIntegration.ts",
    "test:performance": "tsx src/e2e/runDatabaseApiPerformance.ts",
    "auth:provision-admin": "pnpm run db:generate && tsx src/auth/provisionAdminCommand.ts",
    "auth:provision-admin:compiled": "node dist/auth/provisionAdminCommand.js",
    "db:register-capability": "pnpm run db:generate && tsx src/db/registerDatabaseCapabilityCommand.ts",
    "db:register-capability:compiled": "node dist/db/registerDatabaseCapabilityCommand.js",
    "content:load-tags": "pnpm run db:generate && tsx src/content/tagLoadCommand.ts",
    "content:load-tags:compiled": "node dist/content/tagLoadCommand.js",
    "content:load-rush-words": "pnpm run db:generate && tsx src/content/rushWordLoadCommand.ts",
    "content:load-rush-words:compiled": "node dist/content/rushWordLoadCommand.js",
    "content:generate-furigana": "tsx src/content/furiganaGenerateCommand.ts",
    "content:generate-passage-audio": "tsx src/content/passageAudioGenerateCommand.ts",
    "content:load-furigana": "pnpm run db:generate && tsx src/content/furiganaLoadCommand.ts",
    "content:load-furigana:compiled": "node dist/content/furiganaLoadCommand.js",
    "content:publish-question-set": "pnpm run db:generate && tsx src/content/questionSetPublishCommand.ts",
    "content:publish-question-set:compiled": "node dist/content/questionSetPublishCommand.js",
    "content:publish-explanation-ja": "pnpm run db:generate && tsx src/content/explanationJaPublishCommand.ts",
    "content:publish-explanation-ja:compiled": "node dist/content/explanationJaPublishCommand.js",
    "auth:erase-deletion-pending": "pnpm run db:generate && tsx src/auth/ssoAccountErasureCommand.ts",
    "auth:erase-deletion-pending:compiled": "node dist/auth/ssoAccountErasureCommand.js",
    "auth:reapply-erasure": "pnpm run db:generate && tsx src/auth/accountErasureReapplyCommand.ts",
    "auth:reapply-erasure:compiled": "node dist/auth/accountErasureReapplyCommand.js",
    "study:cleanup-expired-guests": "pnpm run db:generate && tsx src/study/studySessionCleanupCommand.ts",
    "study:cleanup-expired-drafts": "pnpm run db:generate && tsx src/study/studyDraftCleanupCommand.ts",
    "study:count-retention": "pnpm run db:generate && tsx src/study/retentionCohortCommand.ts",
    "report:redact-expired-descriptions": "pnpm run db:generate && tsx src/report/userReportRetentionCommand.ts",
    "notification:send-daily-push": "pnpm run db:generate && tsx src/notification/dailyPushCommand.ts",
    "auth:delete-expired-sessions": "pnpm run db:generate && tsx src/auth/sessionRetentionCommand.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev --config prisma.dev.config.ts",
    "db:migrate:dev:deploy": "prisma migrate deploy --config prisma.dev.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.migrate.config.ts",
    "db:migrate:test": "prisma migrate deploy --config prisma.test.config.ts",
    "db:seed:dev": "pnpm run db:generate && SEED_TARGET=development tsx prisma/seed.ts",
    "db:seed:test": "pnpm run db:generate && SEED_TARGET=test tsx prisma/seed.ts",
    "study:count-retention:compiled": "node dist/study/retentionCohortCommand.js",
    "auth:delete-expired-sessions:compiled": "node dist/auth/sessionRetentionCommand.js",
    "study:cleanup-expired-drafts:compiled": "node dist/study/studyDraftCleanupCommand.js",
    "report:redact-expired-descriptions:compiled": "node dist/report/userReportRetentionCommand.js",
    "study:cleanup-expired-guests:compiled": "node dist/study/studyGuestCleanupRuntime.js"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.14",
    "@hono/node-server": "2.1.6",
    "@nihongo/contracts": "workspace:*",
    "@nihongo/domain": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.7.14",
    "dotenv": "17.4.2",
    "hono": "4.13.16",
    "pg": "8.23.0",
    "web-push": "3.6.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@aws-sdk/client-polly": "3.1175.0",
    "@aws-sdk/client-s3": "3.1175.0",
    "@types/node": "22.15.32",
    "@types/pg": "8.21.0",
    "@types/web-push": "3.6.4",
    "lindera-wasm-nodejs-ipadic": "2.0.0",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  }
}
