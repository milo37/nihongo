{
  "name": "jlpt-drill-note",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": "22.23.0"
  },
  "volta": {
    "node": "22.23.0",
    "pnpm": "10.2.1"
  },
  "scripts": {
    "postinstall": "node scripts/msw/patch-worker.mjs",
    "dev": "pnpm run build:contracts && pnpm run build:domain && pnpm --parallel --filter @nihongo/web --filter @nihongo/api run dev",
    "dev:web": "pnpm run build:contracts && pnpm run build:domain && pnpm --filter @nihongo/web run dev",
    "dev:api": "pnpm run build:contracts && pnpm run build:domain && pnpm --filter @nihongo/api run dev",
    "build:contracts": "pnpm --filter @nihongo/contracts run build",
    "build:domain": "pnpm --filter @nihongo/domain run build",
    "build": "pnpm -r --if-present run build",
    "preview": "pnpm --filter @nihongo/web run preview",
    "check:architecture": "pnpm run build:contracts && node scripts/architecture/cli.mjs",
    "typecheck": "pnpm run build:contracts && pnpm run build:domain && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:architecture": "node --test scripts/architecture/*.test.mjs",
    "test:content-runtime": "node --test scripts/content/*.test.mjs",
    "test:contracts": "pnpm --filter @nihongo/contracts run test",
    "test:domain": "pnpm --filter @nihongo/domain run test",
    "test:api": "pnpm --filter @nihongo/api run test",
    "test:historical-runner-boundary": "node --test scripts/assert-historical-pre-phase7-runner.test.mjs",
    "test:phase7:static": "node scripts/msw/patch-worker.mjs --check && node --test scripts/assert-historical-pre-phase7-runner.test.mjs scripts/phase7-local-provisioning.test.mjs",
    "test:integration": "node scripts/assert-historical-pre-phase7-runner.mjs && pnpm --filter @nihongo/api exec tsx src/e2e/runSlice5Integration.ts",
    "test:integration:slice3": "node scripts/assert-historical-pre-phase7-runner.mjs && pnpm --filter @nihongo/api exec tsx src/e2e/runSlice3Integration.ts",
    "test:integration:slice5": "node scripts/assert-historical-pre-phase7-runner.mjs && pnpm --filter @nihongo/api exec tsx src/e2e/runSlice5Integration.ts",
    "test:phase7:db": "pnpm --filter @nihongo/api exec tsx src/e2e/runPhase7DbIntegration.ts",
    "test:phase7:api": "pnpm --filter @nihongo/api run test:phase7:api",
    "test:phase7:browser:mock": "pnpm --filter @nihongo/api exec tsx src/e2e/runPhase7Browser.ts mock",
    "test:phase7:browser:real": "pnpm --filter @nihongo/api exec tsx src/e2e/runPhase7Browser.ts real",
    "test:phase8:browser:mock": "PHASE8_BROWSER_ACCEPTANCE=1 pnpm --filter @nihongo/api exec tsx src/e2e/runPhase7Browser.ts mock",
    "test:phase8:browser:real": "PHASE8_BROWSER_ACCEPTANCE=1 pnpm --filter @nihongo/api exec tsx src/e2e/runPhase7Browser.ts real",
    "test:phase9:static": "node --test scripts/phase9-database-contract.test.mjs && pnpm --filter @nihongo/web run test:phase9:static",
    "test:phase9:browser:mock": "pnpm --filter @nihongo/api exec tsx ../../scripts/runPhase9Browser.ts mock",
    "test:phase9:browser:real": "pnpm --filter @nihongo/api exec tsx ../../scripts/runPhase9Browser.ts real",
    "auth:provision-admin": "pnpm --filter @nihongo/api run auth:provision-admin",
    "content:author-prepare": "node scripts/content/run-retained-validator.mjs author-prepare",
    "content:check": "node scripts/content/run-retained-validator.mjs check",
    "content:validate": "node scripts/content/run-retained-validator.mjs validate",
    "content:coverage": "node scripts/content/run-retained-validator.mjs coverage",
    "content:duplicates": "node scripts/content/run-retained-validator.mjs duplicates",
    "content:legacy-policy-finalize": "node scripts/content/run-retained-validator.mjs legacy-policy-finalize",
    "content:legacy-policy-prepare": "node scripts/content/run-retained-validator.mjs legacy-policy-prepare",
    "content:policy-finalize": "node scripts/content/run-retained-validator.mjs policy-finalize",
    "content:policy-prepare": "node scripts/content/run-retained-validator.mjs policy-prepare",
    "content:policy-activation-prepare": "node scripts/content/run-retained-validator.mjs policy-activation-prepare",
    "content:policy-activation-finalize": "node scripts/content/run-retained-validator.mjs policy-activation-finalize",
    "content:review-prepare": "node scripts/content/run-retained-validator.mjs review-prepare",
    "content:review-check": "node scripts/content/run-retained-validator.mjs review-check",
    "content:foundation-check": "pnpm run content:foundation-check:static && pnpm --filter @nihongo/web run build && pnpm run content:foundation-check:seed",
    "content:foundation-check:seed": "pnpm run test:phase7:db",
    "content:foundation-check:static": "pnpm run build:domain && pnpm --filter @nihongo/api run content:foundation-check && pnpm --filter @nihongo/api exec vitest run prisma/phase6Slice1FoundationCheck.test.ts && pnpm --filter @nihongo/web exec vitest run src/mocks/data/questions/questions.test.ts && pnpm run check:architecture",
    "content:materialize-slice1": "pnpm run build:domain && pnpm --filter @nihongo/api run content:materialize-slice1 && prettier --write content/schema/content-bundle.schema.v1.json content/review/duplicate-review-plan.schema.v1.json content/review/review-certificate.schema.v1.json content/review/release-approval-receipt.schema.v1.json content/policies/policy-activation.schema.v1.json content/taxonomy/tags.v1.json content/coverage/internal-beta.v1.json content/legacy/legacy-seed-source-manifest.v1.json content/legacy/legacy-seed-mapping-manifest.v1.json content/releases/legacy-system-seed-v1/1/legacy-seed-manifest.json",
    "review:reconcile": "pnpm --filter @nihongo/api run review:reconcile",
    "study:cleanup-expired-guests": "pnpm --filter @nihongo/api run study:cleanup-expired-guests",
    "study:cleanup-expired-drafts": "pnpm --filter @nihongo/api run study:cleanup-expired-drafts",
    "test:web": "pnpm --filter @nihongo/web run test",
    "test:e2e": "node scripts/assert-historical-pre-phase7-runner.mjs && pnpm run build:contracts && pnpm run build:domain && pnpm run db:generate && pnpm --filter @nihongo/api exec tsx src/e2e/runSlice2E2e.ts",
    "test": "pnpm run test:phase7:static && pnpm run build:contracts && pnpm run build:domain && pnpm run test:architecture && pnpm run test:content-runtime && pnpm run test:contracts && pnpm run test:domain && pnpm run test:api && pnpm run test:web",
    "test:watch": "pnpm -r --parallel --if-present run test:watch",
    "db:generate": "pnpm --filter @nihongo/api run db:generate",
    "db:migrate:dev": "pnpm --filter @nihongo/api run db:migrate:dev",
    "db:migrate:dev:deploy": "pnpm --filter @nihongo/api run db:migrate:dev:deploy",
    "db:migrate:deploy": "pnpm --filter @nihongo/api run db:migrate:deploy",
    "db:migrate:phase7": "pnpm --filter @nihongo/api run db:migrate:phase7",
    "db:migrate:test": "pnpm --filter @nihongo/api run db:migrate:test",
    "db:seed:dev": "pnpm --filter @nihongo/api run db:seed:dev",
    "db:seed:test": "pnpm --filter @nihongo/api run db:seed:test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
