{
  "name": "jlpt-drill-note",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nihongo/web run dev",
    "build": "pnpm --filter @nihongo/web run build",
    "preview": "pnpm --filter @nihongo/web run preview",
    "typecheck": "pnpm --filter @nihongo/web run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @nihongo/web run test",
    "test:watch": "pnpm --filter @nihongo/web run test:watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
